# Copy this file to .env in the project root and fill in the two InsForge values.
# Vite reads this file. Only names that start with VITE_ are visible in the browser.

# InsForge project URL. In the dashboard this is the API / OSS host,
# for example https://your-app.us-east.insforge.app
VITE_INSFORGE_URL=

# Public anon key. Dashboard: Install -> API Keys, or:
# npx -y @insforge/cli secrets get ANON_KEY
VITE_INSFORGE_ANON_KEY=

# Do not put the OpenRouter key here. It must stay on the server.
# After the project is linked, store it as an InsForge secret:
# npx -y @insforge/cli secrets add OPENROUTER_API_KEY <your-openrouter-key>
# Then deploy the remodel function:
# npx -y @insforge/cli functions deploy remodel --file functions/remodel.ts
